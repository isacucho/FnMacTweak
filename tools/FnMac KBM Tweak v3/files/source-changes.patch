+static NSInteger (*g_origUIKeyKeyCode)(id, SEL) = NULL;
+static NSString *(*g_origUIKeyCharacters)(id, SEL) = NULL;
+static NSMutableDictionary<NSString *, NSValue *> *g_fnkbmPressOrig = nil;
+static int g_fnkbmPressDepth = 0;
+static BOOL g_fnkbmXlatRead = NO;   // the game read a translated key code
+static BOOL g_fnkbmPhysDown[512] = {NO};    // key is down on the keyboard, as far as the key methods saw
+static __weak id g_fnkbmPressTarget = nil;  // the game object that takes key presses
+
+// ── Key releases the game must not miss ──────────────────────────────────
+// The game keeps every key it was given a key-down for in a table and repeats
+// it on its own, every frame, until a key-up with the same identity arrives.
+// Letters and digits are known by their character, other keys by key code. So:
+// - a key-up must carry what the game read at its key-down (Shift or Option
+//   changed in between would otherwise give a different character);
+// - a key-up that never arrives (macOS drops it while Command is held, the key
+//   window changes, a panel of the tweak takes the keyboard, focus is lost) is
+//   sent from here, straight to the game's own key method.
+static BOOL g_fnkbmGameDown[512] = {NO};        // the game was given a key-down for this physical key
+static uint16_t g_fnkbmDownCode[512] = {0};     // key code the game read at that key-down
+static NSString *g_fnkbmDownChars[512];         // characters the game read at that key-down
+static int g_fnkbmReplayUp = 0;                 // > 0 while a real key-up is handed to the game
+static BOOL g_fnkbmUpPending[512] = {NO};       // release wanted, the game could not take it yet
+static uint8_t g_fnkbmUpTicks[512] = {0};       // checks in a row that found the key up
+static unsigned g_fnkbmPressGen[512] = {0};     // counts key-downs, so a later echo knows it is stale
+static BOOL g_fnkbmUpInMenu[512] = {NO};        // released while the game showed its cursor
+static uint64_t g_fnkbmUpAt[512] = {0};         // mach time of the last release the game was given
+static uint8_t g_fnkbmTapKey[512] = {0};        // the event tap's view: 0 not known, 1 down, 2 up
+static BOOL g_fnkbmTapSeesKeys = NO;
+static bool (*_CGEventSourceKeyState)(int32_t stateID, uint16_t key) = NULL;
+static BOOL g_fnkbmKeyStateWorks = NO;          // CGEventSourceKeyState has reported a held key as down
+static BOOL g_fnkbmReconRunning = NO;
