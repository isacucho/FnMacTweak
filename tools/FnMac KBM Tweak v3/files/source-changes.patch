+static id hooked_nextDrawable(id self, SEL _cmd) {
+    if (g_fnkbmLayer != self) {
+        g_fnkbmLayer = self;
+        NSUInteger had = ((NSUInteger (*)(id, SEL))objc_msgSend)(self, NSSelectorFromString(@"maximumDrawableCount"));
+        CGSize fnkbmSize = ((CGSize (*)(id, SEL))objc_msgSend)(self, NSSelectorFromString(@"drawableSize"));
+        CGRect fnkbmBounds = ((CGRect (*)(id, SEL))objc_msgSend)(self, NSSelectorFromString(@"bounds"));
+        KLOG("frame layer output size %.0fx%.0f pixels in a layer of %.0fx%.0f points", fnkbmSize.width, fnkbmSize.height, fnkbmBounds.size.width, fnkbmBounds.size.height);
+        KLOG("frame layer %p, display sync hook=%d, drawable count %lu -> %lu", self, g_origSetDisplaySync != NULL, (unsigned long)had,
+             (unsigned long)((NSUInteger (*)(id, SEL))objc_msgSend)(self, NSSelectorFromString(@"maximumDrawableCount")));
+        fnkbmApplyDisplaySync();
+        dispatch_async(dispatch_get_main_queue(), ^{ fnkbmApplyColorFilter(); });
+    }
+    if ((atomic_fetch_add(&g_fnkbmFrames, 1) & 255) == 0) {
+        static CGSize fnkbmLast; static int fnkbmSaid = 0;
+        CGSize now = ((CGSize (*)(id, SEL))objc_msgSend)(self, NSSelectorFromString(@"drawableSize"));
+        if ((now.width != fnkbmLast.width || now.height != fnkbmLast.height) && fnkbmSaid < 12) {
+            fnkbmSaid++; fnkbmLast = now;
+            KLOG("frame layer output size now %.0fx%.0f pixels", now.width, now.height);
+        }
+    }
+    uint64_t pauseUntil = atomic_exchange(&g_fnkbmPauseUntil, 0);
+    if (pauseUntil > mach_absolute_time()) mach_wait_until(pauseUntil);
+    uint64_t t0 = mach_absolute_time();
+    atomic_fetch_add(&g_dgNdIn, 1); atomic_store(&g_dgNdTin, t0);
+    id drawable = g_origNextDrawable(self, _cmd);
+    uint64_t t1 = mach_absolute_time();
+    atomic_fetch_add(&g_dgNdOut, 1); atomic_store(&g_dgNdTout, t1); if (!drawable) atomic_fetch_add(&g_dgNdNil, 1);
+    atomic_fetch_add(&g_fnkbmDrawableWait, (long)(t1 - t0));
+    atomic_fetch_add(&g_fnkbmFastFrames, 1); atomic_fetch_add(&g_fnkbmFastWait, (long)(t1 - t0));
+    atomic_store(&g_fnkbmAcquireTick, t1);
+    return drawable;
+}
+static void hooked_pacerSignal(id self, SEL _cmd, id param) {
+    g_fnkbmPacer = self; g_fnkbmPacerParam = param; g_fnkbmPacerSel = _cmd;
