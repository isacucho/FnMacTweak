+// Stands in for a UIPress and its UIKey. The game reads only press.key,
+// key.characters and key.keyCode.
+@interface FnkbmKeyShim : NSObject
+@property (nonatomic) long code;
+@property (nonatomic, copy) NSString *chars;
+@end
+@implementation FnkbmKeyShim
+- (id)key { return self; }
+- (NSInteger)keyCode { return _code; }
+- (NSString *)characters { return _chars ?: @""; }
+- (NSString *)charactersIgnoringModifiers { return _chars ?: @""; }
