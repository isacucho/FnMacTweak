+        g_fnkbmGfxWindow = [[FnkbmPanelWindow alloc] initWithWindowScene:game.windowScene];
+        g_fnkbmGfxWindow.windowLevel = UIWindowLevelAlert + 2;
+        g_fnkbmGfxWindow.backgroundColor = UIColor.clearColor;
+    }
+    g_fnkbmGfxWindow.frame = game.frame;
+    fnkbmReleaseAllGameKeys("graphics panel opened");
+    g_fnkbmLockedBeforePanel = isMouseLocked;
+    g_fnkbmGfxPanelOpen = YES;
+    isPopupVisible = YES;
+    isMouseLocked = NO;
