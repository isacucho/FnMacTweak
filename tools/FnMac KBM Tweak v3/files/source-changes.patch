+// Key release lines also go to Documents/fnkbm-keys.log, because macOS stops
+// keeping the app's log lines after about a minute and a half.
+static void fnkbmKeyNote(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void fnkbmKeyNote(const char *fmt, ...) {
+    static int fd = -2, lines = 0;
+    char line[200];
+    va_list ap;
+    va_start(ap, fmt); vsnprintf(line, sizeof(line), fmt, ap); va_end(ap);
+    KLOG("%{public}s", line);
+    if (fd == -2) fd = open([NSHomeDirectory() stringByAppendingPathComponent:@"Documents/fnkbm-keys.log"].fileSystemRepresentation, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0 || lines >= 300) return;
+    lines++;
+    struct timeval tv; gettimeofday(&tv, NULL);
+    struct tm tm; localtime_r(&tv.tv_sec, &tm);
+    char out[240];
+    int n = snprintf(out, sizeof(out), "%02d:%02d:%02d.%03d %s\n", tm.tm_hour, tm.tm_min, tm.tm_sec, (int)(tv.tv_usec / 1000), line);
+    if (n > 0) write(fd, out, (size_t)MIN(n, (int)sizeof(out) - 1));
+}
+
+// nsVKToGC is wrong for F3, F8 to F11, F13 to F20 and most of the keypad, so
+// gcToNSVK is trusted only for these key codes: letters, digits, punctuation,
+// Return, Esc, Tab, Space, F1, F2, F4 to F7, F12, Insert to the arrows, and the
+// modifiers. The others come from kFnkbmVKFix.
+static BOOL fnkbmVKMapTrusted(long code) {
+    return (code >= 4 && code <= 56) || code == 58 || code == 59 || (code >= 61 && code <= 64) || code == 69
+        || (code >= 73 && code <= 82) || (code >= 224 && code <= 231);
+}
+// {key code (USB HID usage), macOS virtual key} from IOHIDUsageTables.h and HIToolbox Events.h.
+static const uint16_t kFnkbmVKFix[][2] = {
+    {60, 0x63}, {65, 0x64}, {66, 0x65}, {67, 0x6D}, {68, 0x67},                     // F3, F8 to F11
+    {104, 0x69}, {105, 0x6B}, {106, 0x71}, {107, 0x6A},                             // F13 to F16
+    {108, 0x40}, {109, 0x4F}, {110, 0x50}, {111, 0x5A},                             // F17 to F20
+    {83, 0x47}, {84, 0x4B}, {85, 0x43}, {86, 0x4E}, {87, 0x45}, {88, 0x4C},         // keypad Clear / * - + Enter
+    {89, 0x53}, {90, 0x54}, {91, 0x55}, {92, 0x56}, {93, 0x57},                     // keypad 1 to 5
+    {94, 0x58}, {95, 0x59}, {96, 0x5B}, {97, 0x5C},                                 // keypad 6 to 9
+    {98, 0x52}, {99, 0x41}, {103, 0x51},                                            // keypad 0 . =
+};
+#define FNKBM_VK_NONE 0xFFFF
+// macOS virtual key of a key code, or FNKBM_VK_NONE.
+static uint16_t fnkbmPhysVK(long code) {
+    for (size_t i = 0; i < sizeof(kFnkbmVKFix) / sizeof(kFnkbmVKFix[0]); i++) if (kFnkbmVKFix[i][0] == code) return kFnkbmVKFix[i][1];
+    if (code <= 0 || code >= 256 || !fnkbmVKMapTrusted(code)) return FNKBM_VK_NONE;
+    uint16_t vk = gcToNSVK[code];
+    return (vk != 0 || code == 4) ? vk : FNKBM_VK_NONE;   // virtual key 0 is A; elsewhere 0 means no mapping
+}
+// Key code of a macOS virtual key, or 0.
+static long fnkbmGCForVK(long vk) {
+    for (size_t i = 0; i < sizeof(kFnkbmVKFix) / sizeof(kFnkbmVKFix[0]); i++) if (kFnkbmVKFix[i][1] == vk) return kFnkbmVKFix[i][0];
+    long gc = (vk >= 0 && vk < 128) ? nsVKToGC[vk] : 0;
+    return (gc > 0 && fnkbmPhysVK(gc) == vk) ? gc : 0;
+}
+
+// Is the physical key down now? 1 down, 0 up, -1 not known.
+static int fnkbmKeyPhysDown(long code) {
+    if (code <= 0 || code >= 512) return -1;
+    if (g_fnkbmSynthHeld[code]) return 1;              // held by the tweak itself
+    uint16_t vk = fnkbmPhysVK(code);
+    if (vk == FNKBM_VK_NONE) return -1;
+    if (_CGEventSourceKeyState) {
+        bool down = _CGEventSourceKeyState(0, vk);      // combined session state
+        // Trusted only once it has reported a held key, in case the sandbox
+        // makes it answer "up" for everything.
+        if (down) g_fnkbmKeyStateWorks = YES;
+        if (g_fnkbmKeyStateWorks) return down ? 1 : 0;
+    }
+    if (g_fnkbmTapSeesKeys && g_fnkbmTapKey[code]) return g_fnkbmTapKey[code] == 1 ? 1 : 0;
+    return -1;
+}
+
+// Hands the game a key-up for a physical key, with what it read at the key-down,
+// through its own key method. 1 sent, 0 the game cannot take it now, -1 never.
+static int fnkbmSendGameUp(long phys) {
+    id vc = g_fnkbmPressTarget;
+    SEL s = sel_registerName("ProcessKeyPresses:eventType:");
+    if (!vc || ![vc respondsToSelector:s]) {
+        static BOOL said = NO;
+        if (!said) { said = YES; fnkbmKeyNote("key release: the game's key method is not reachable, release of key %ld not sent", phys); }
+        return -1;
+    }
+    if (![GCKeyboard coalescedKeyboard]) return 0;   // the game would drop it
+    FnkbmKeyShim *k = [FnkbmKeyShim new];
+    k.code = g_fnkbmDownCode[phys] ?: phys;
+    k.chars = g_fnkbmDownChars[phys];
+    ((BOOL (*)(id, SEL, NSSet *, int))objc_msgSend)(vc, s, [NSSet setWithObject:k], 1);   // 1 = key up
+    return 1;
+}
+static void fnkbmReconcileStart(void);
+static void fnkbmNoteRelease(long code);
+static void fnkbmGameKeyUp(long phys, const char *why) {
+    int r = fnkbmSendGameUp(phys);
+    if (r == 0) { g_fnkbmUpPending[phys] = YES; fnkbmReconcileStart(); return; }   // tried again at the next check
+    if (r > 0) fnkbmNoteRelease(phys);   // same bookkeeping as a real release, so it is given again after a menu
+    g_fnkbmGameDown[phys] = NO; g_fnkbmUpPending[phys] = NO; g_fnkbmUpTicks[phys] = 0;
+    static int said = 0;
+    if (r > 0 && said < 200) { said++; fnkbmKeyNote("key %ld: release never reached the game, sent now (%s)", phys, why); }
+}
+// Every 50 ms while the game holds a key: a key found up on the keyboard at two
+// checks in a row whose release has not reached the game gets it from here.
+// A key that holds a bound mouse button or key for the game lets that go too.
+static void fnkbmReconcileTick(void) {
+    BOOL any = NO;
+    for (long code = 1; code < 512; code++) {
+        if (!g_fnkbmGameDown[code] && !g_fnkbmKeyHolding[code]) { g_fnkbmUpTicks[code] = 0; continue; }
+        if (g_fnkbmGameDown[code] && g_fnkbmUpPending[code]) fnkbmGameKeyUp(code, "retried");
+        else if (fnkbmKeyPhysDown(code) != 0) g_fnkbmUpTicks[code] = 0;
+        else if (++g_fnkbmUpTicks[code] >= 2) {
+            long held = g_fnkbmKeyHolding[code];
+            if (held) {
+                g_fnkbmKeyHolding[code] = 0;
+                remappedKeysState[code] = NO;
+                _sendDualKeyEvent((GCKeyCode)held, NO);
+                fnkbmKeyNote("key %ld: release of its bind %ld never came, sent now", code, held);
+            }
+            if (g_fnkbmGameDown[code]) fnkbmGameKeyUp(code, "key is up");
+            g_fnkbmUpTicks[code] = 0;
+        }
+        if (g_fnkbmGameDown[code] || g_fnkbmKeyHolding[code]) any = YES;
+    }
+    if (!any) { g_fnkbmReconRunning = NO; return; }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 50 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{ fnkbmReconcileTick(); });
+}
+static void fnkbmReconcileStart(void) {
+    if (g_fnkbmReconRunning) return;
+    g_fnkbmReconRunning = YES;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 50 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{ fnkbmReconcileTick(); });
+}
+// Every key the game holds is let go now: focus lost, a panel of the tweak
+// opened, typing mode switched. Their real releases go elsewhere.
+static void fnkbmReleaseAllGameKeys(const char *why) {
+    for (long code = 1; code < 512; code++) if (g_fnkbmGameDown[code]) fnkbmGameKeyUp(code, why);
+}
+
+// Mouse buttons get the same check, side buttons included. Every press handed to the
+// game is kept with the handler and button that got it, and a button bound to a key
+// keeps that key in g_fnkbmKeyDown. While one is kept, the mouse is asked every 50 ms
+// whether the button is still down; found up at two checks in a row, the release the
+// game never got is handed to that handler, or the bound key is let go. A real release
+// arriving later is dropped, because the press is no longer recorded.
+static GCControllerButtonValueChangedHandler g_fnkbmBtnToldHandler[FNKBM_BTN_SLOTS][2];   // [slot][0 pressedChanged, 1 valueChanged]
+static GCControllerButtonInput *g_fnkbmBtnToldBtn[FNKBM_BTN_SLOTS][2];
+static uint8_t g_fnkbmBtnUpTicks[FNKBM_BTN_SLOTS];
+static BOOL g_fnkbmBtnReconRunning = NO;
+// Is the mouse button down now? 1 down, 0 up, -1 not known.
+static int fnkbmButtonPhysDown(int code) {
+    static bool (*buttonState)(int32_t, uint32_t) = NULL;
+    // Trusted per system button once it has reported that button held, in case the
+    // sandbox answers "up" for all, or a side button has another system number.
+    static BOOL works[32];
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        void *cg = dlopen("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics", RTLD_NOW);
+        if (cg) buttonState = (bool (*)(int32_t, uint32_t))dlsym(cg, "CGEventSourceButtonState");
+        KLOG("mouse button state read=%d", buttonState != NULL);
+    });
+    // System numbers: 0 left, 1 right, 2 middle, 3 on for the side buttons (as _sendMouseButtonEvent).
+    int b = code == MOUSE_BUTTON_LEFT ? 0 : code == MOUSE_BUTTON_RIGHT ? 1 : code == MOUSE_BUTTON_MIDDLE ? 2
+          : (code >= MOUSE_BUTTON_AUX_BASE && code <= MOUSE_BUTTON_AUX_MAX) ? code - MOUSE_BUTTON_AUX_BASE + 3 : -1;
+    if (b < 0 || b > 31 || !buttonState) return -1;
+    bool down = buttonState(0, (uint32_t)b);   // combined session state
+    if (down && !works[b]) { works[b] = YES; KLOG("mouse button %d: state read as system button %d", code, b); }
+    return works[b] ? (down ? 1 : 0) : -1;
+}
+static void fnkbmBtnReconTick(void) {
+    BOOL any = NO;
+    for (int slot = 0; slot < FNKBM_BTN_SLOTS; slot++) {
+        int code = slot + MOUSE_BUTTON_MIDDLE;
+        BOOL told = g_fnkbmBtnToldHandler[slot][0] || g_fnkbmBtnToldHandler[slot][1];
+        if (!told && !g_fnkbmKeyDown[slot]) { g_fnkbmBtnUpTicks[slot] = 0; continue; }
+        any = YES;
+        if (fnkbmButtonPhysDown(code) != 0) { g_fnkbmBtnUpTicks[slot] = 0; continue; }
+        if (++g_fnkbmBtnUpTicks[slot] < 2) continue;
+        g_fnkbmBtnUpTicks[slot] = 0;
+        if (g_fnkbmKeyDown[slot]) {
+            GCKeyCode target = g_fnkbmKeyDown[slot];
+            g_fnkbmKeyDown[slot] = 0;
+            _sendDualKeyEvent(target, NO);
+            fnkbmKeyNote("mouse button %d: release of its bind %ld never came, sent now", code, (long)target);
+        }
+        if (!told) continue;
+        for (int p = 0; p < 2; p++) {
+            GCControllerButtonValueChangedHandler h = g_fnkbmBtnToldHandler[slot][p];
+            GCControllerButtonInput *btn = g_fnkbmBtnToldBtn[slot][p];
+            g_fnkbmBtnToldHandler[slot][p] = nil;
+            g_fnkbmBtnToldBtn[slot][p] = nil;
+            if (h) h(btn, 0.0f, NO);
+        }
+        g_fnkbmFwdPressed[slot] = NO; g_fnkbmFwdValue[slot] = NO; g_fnkbmBtnUpTicks[slot] = 0;
+        if (code == MOUSE_BUTTON_RIGHT) rightButtonIsPressed = NO;
+        fnkbmKeyNote("mouse button %d: release never reached the game, sent now", code);
+    }
+    if (!any) { g_fnkbmBtnReconRunning = NO; return; }
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 50 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{ fnkbmBtnReconTick(); });
+}
+// A press given to the game: the button is read once now, while it is surely down,
+// so its state can be trusted, and the checks start. Main thread.
+static void fnkbmBtnWatch(int code) {
+    fnkbmButtonPhysDown(code);
+    if (g_fnkbmBtnReconRunning) return;
+    g_fnkbmBtnReconRunning = YES;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 50 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{ fnkbmBtnReconTick(); });
+}
+// A forwarded press (handler set) or release (handler nil) of a mouse button. Main thread.
+static void fnkbmBtnTold(int code, int path, GCControllerButtonValueChangedHandler handler, GCControllerButtonInput *btn) {
+    int slot = code - MOUSE_BUTTON_MIDDLE;
+    if (slot < 0 || slot >= FNKBM_BTN_SLOTS) return;
+    g_fnkbmBtnToldHandler[slot][path] = handler;
+    g_fnkbmBtnToldBtn[slot][path] = handler ? btn : nil;
+    if (handler) fnkbmBtnWatch(code);
+}
+
+// A key released while the game shows its cursor (a menu, or one of the short
+// flips during play) may not be seen by the game's play controls, which keep
+// walking. Such releases are given to the game again when it hides its cursor
+// (fnkbmReleaseMissedKeys). Without the game's log there is no cursor state, so
+// each release is echoed 0.25 s, 1 s and 3 s later instead, unless the key was
+// pressed again. A release for a key that is already up changes nothing.
+static void fnkbmNoteRelease(long code) {
+    if (!g_fnkbmGameDown[code]) return;                // the game never had this key down
+    g_fnkbmUpAt[code] = mach_absolute_time();
+    if (g_fnkbmHaveGameCursor) { if (g_fnkbmGameCursorShown) g_fnkbmUpInMenu[code] = YES; return; }
+    unsigned gen = g_fnkbmPressGen[code];
+    const int64_t ms[3] = {250, 1000, 3000};
+    for (int i = 0; i < 3; i++)
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, ms[i] * (int64_t)NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+            if (gen == g_fnkbmPressGen[code] && !g_fnkbmGameDown[code] && fnkbmKeyPhysDown(code) != 1) fnkbmSendGameUp(code);
+        });
+}
+// The game just showed its cursor: keys let go shortly before count as released
+// in a menu too (300 ms, plus about 100 ms for the game's log to reach the tweak).
+static void fnkbmMarkRecentReleases(void) {
+    static mach_timebase_info_data_t tb; if (tb.denom == 0) mach_timebase_info(&tb);
+    uint64_t now = mach_absolute_time();
+    for (long code = 1; code < 512; code++)
+        if (g_fnkbmUpAt[code] && !g_fnkbmGameDown[code] && (now - g_fnkbmUpAt[code]) * tb.numer / tb.denom < 400 * NSEC_PER_MSEC) g_fnkbmUpInMenu[code] = YES;
+}
+
+static IMP fnkbmPressOrigFor(id obj, SEL sel) {
+    for (Class c = object_getClass(obj); c; c = class_getSuperclass(c)) {
+        NSValue *v = g_fnkbmPressOrig[[NSString stringWithFormat:@"%p/%s", (void *)c, sel_getName(sel)]];
+        if (v) return (IMP)v.pointerValue;
+    }
+    return NULL;
+}
+static long fnkbmPhysicalKey(UIPress *p) {
+    id k = [p respondsToSelector:@selector(key)] ? p.key : nil;
+    if (!k || !g_origUIKeyKeyCode) return 0;
+    long c = (long)g_origUIKeyKeyCode(k, @selector(keyCode));
+    return (c > 0 && c < 512) ? c : 0;
+}
+// Caps Lock: macOS reports it as a switch, on at one press and off at the
+// next, so the game would see it held down until pressed again. The game does
+// know the key. Each change is therefore given to the game as a short press:
+// down now, up 40 ms later. It cannot be held.
+static BOOL fnkbmCapsTap(id self, SEL _cmd, NSSet *presses, id event) {
+    if (isTypingModeEnabled || presses.count == 0) return NO;
+    for (UIPress *p in presses) if (fnkbmPhysicalKey(p) != 57) return NO;
+    BOOL change = sel_isEqual(_cmd, @selector(pressesBegan:withEvent:)) || sel_isEqual(_cmd, @selector(pressesEnded:withEvent:));
+    if (!change) return YES;                              // changed / cancelled: nothing to tell the game
+    IMP down = fnkbmPressOrigFor(self, @selector(pressesBegan:withEvent:)), up = fnkbmPressOrigFor(self, @selector(pressesEnded:withEvent:));
+    if (!down || !up) return NO;
+    KLOG("caps lock: sent to the game as a short press");
+    ((void (*)(id, SEL, NSSet *, id))down)(self, @selector(pressesBegan:withEvent:), presses, event);
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 40 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+        ((void (*)(id, SEL, NSSet *, id))up)(self, @selector(pressesEnded:withEvent:), presses, event);
+    });
+    return YES;
+}
+static void fnkbmHookedPresses(id self, SEL _cmd, NSSet *presses, id event) {
+    if (g_fnkbmPressDepth == 0 && fnkbmCapsTap(self, _cmd, presses, event)) return;
+    IMP orig = fnkbmPressOrigFor(self, _cmd);
+    BOOL began = sel_isEqual(_cmd, @selector(pressesBegan:withEvent:));
+    BOOL ended = sel_isEqual(_cmd, @selector(pressesEnded:withEvent:)) || sel_isEqual(_cmd, @selector(pressesCancelled:withEvent:));
+    NSMutableSet *pass = nil;
+    BOOL startCheck = NO;
+    for (UIPress *p in presses) {
+        long code = fnkbmPhysicalKey(p);
+        if (!code) continue;
+        if (code >= 224 && code <= 231) g_fnkbmModsInProcess = YES;
+        if (g_fnkbmPressDepth == 0 && code < 512) {
+            if (began) {
+                g_fnkbmPhysDown[code] = YES; g_fnkbmPressGen[code]++; g_fnkbmUpInMenu[code] = NO; g_fnkbmTapKey[code] = 1;
+                // The first object up the responder chain that has the game's key method.
+                SEL keySel = sel_registerName("ProcessKeyPresses:eventType:");
+                for (id r = self; r; r = [r nextResponder]) if ([r respondsToSelector:keySel]) { g_fnkbmPressTarget = r; break; }
+                fnkbmKeyPhysDown(code);   // a held key: shows whether the keyboard state can be read
+            }
+            else if (ended) { g_fnkbmPhysDown[code] = NO; fnkbmNoteRelease(code); }
+        }
+        if (began && g_fnkbmPressDepth == 0) {
+            long t = 0;
+            if (!g_fnkbmSynthHeld[code] && fnkbmRemapActive()) t = fnkbmKeyTarget(code);
+            // Command: the game takes the key but its bind screen does not accept it.
+            // With no bind of its own in the tweak, Left Command is shown to the game
+            // as Insert and Right Command as Home, keys a Mac keyboard does not have.
+            if (t == 0 && !g_fnkbmSynthHeld[code] && !isTypingModeEnabled) { if (code == 227) t = 73; else if (code == 231) t = 74; }
+            g_fnkbmDropped[code] = (t == -1);
+            g_fnkbmXlat[code] = (t > 0 && t < 512) ? (uint16_t)t : 0;
+            if (t >= 10000 && t < 10200) {
+                // Bound to a mouse button: hide the key and press the button.
+                g_fnkbmDropped[code] = YES;
+                g_fnkbmKeyHolding[code] = (uint16_t)t;
+                _sendDualKeyEvent((GCKeyCode)t, YES);
+                startCheck = YES;
+            }
+            if (t != 0) KLOG("key %ld -> %ld (in place)", code, t);
+        }
+        if (g_fnkbmDropped[code]) { if (!pass) pass = [presses mutableCopy]; [pass removeObject:p]; }
+        else if (began && g_fnkbmPressDepth == 0 && code < 512 && [GCKeyboard coalescedKeyboard]) {
+            // What the game is about to read for this key-down, through the getters below.
+            g_fnkbmDownCode[code] = g_fnkbmXlat[code] ?: (uint16_t)code;
+            g_fnkbmDownChars[code] = [[p.key characters] copy];
+            g_fnkbmGameDown[code] = YES; g_fnkbmUpPending[code] = NO; g_fnkbmUpTicks[code] = 0;
+            startCheck = YES;
+        }
+    }
+    NSSet *deliver = pass ?: presses;
+    BOOL outermostBegan = began && g_fnkbmPressDepth == 0;
+    BOOL translated = NO;
+    if (outermostBegan) {
+        for (UIPress *p in presses) { long code = fnkbmPhysicalKey(p); if (code && g_fnkbmXlat[code]) translated = YES; }
+        g_fnkbmXlatRead = NO;
+    }
+    BOOL replay = ended && g_fnkbmPressDepth == 0;   // the getters answer with the key-down's identity
+    if (replay) g_fnkbmReplayUp++;
+    g_fnkbmPressDepth++;
+    if (orig && deliver.count > 0) ((void (*)(id, SEL, NSSet *, id))orig)(self, _cmd, deliver, event);
+    g_fnkbmPressDepth--;
+    if (replay) g_fnkbmReplayUp--;
+    if (startCheck) fnkbmReconcileStart();
+    // Safety net: if the game never reads the translated key code, this way of
+    // binding cannot work here, so go back to the old swallow-and-resend path.
+    if (outermostBegan && translated) {
+        static int unread = 0;
+        if (g_fnkbmXlatRead) unread = 0;
+        else if (++unread >= 3) {
+            g_fnkbmKeysInProcess = NO;
+            memset(g_fnkbmXlat, 0, sizeof(g_fnkbmXlat));
+            memset(g_fnkbmDropped, 0, sizeof(g_fnkbmDropped));
+            KLOG("key translation not read by the game: back to the resend path");
+        }
+    }
+    if (ended && g_fnkbmPressDepth == 0) {
+        BOOL taken = [GCKeyboard coalescedKeyboard] != nil;   // the game's own check passed, so it took the key-up
+        for (UIPress *p in presses) {
+            long code = fnkbmPhysicalKey(p);
+            if (code && g_fnkbmKeyHolding[code]) { _sendDualKeyEvent((GCKeyCode)g_fnkbmKeyHolding[code], NO); g_fnkbmKeyHolding[code] = 0; }
+            if (code) { g_fnkbmXlat[code] = 0; g_fnkbmDropped[code] = NO; }
+            if (code && taken) { g_fnkbmGameDown[code] = NO; g_fnkbmUpPending[code] = NO; }
+        }
+    }
+}
+// The game hid its cursor again (play has the keyboard): keys released while it
+// was shown get their release once more, with the key-down's identity.
+static void fnkbmReleaseMissedKeys(void) {
+    int sent = 0;
+    for (long code = 1; code < 512; code++) {
+        if (!g_fnkbmUpInMenu[code]) continue;
+        int down = fnkbmKeyPhysDown(code);
+        if (down == 1 || (down < 0 && g_fnkbmPhysDown[code])) continue;   // still held: looked at again next time
+        g_fnkbmUpInMenu[code] = NO;
+        if (!g_fnkbmGameDown[code] && fnkbmSendGameUp(code) > 0) sent++;
+    }
+    static int said = 0;
+    if (sent && said < 30) { said++; fnkbmKeyNote("game cursor hidden again: release given to the game again for %d keys", sent); }
+}
+static NSInteger fnkbmHookedKeyCode(id self, SEL _cmd) {
+    NSInteger c = g_origUIKeyKeyCode(self, _cmd);
+    if (g_fnkbmReplayUp && c > 0 && c < 512 && g_fnkbmGameDown[c] && g_fnkbmDownCode[c]) return g_fnkbmDownCode[c];
+    if (c > 0 && c < 512) { uint16_t t = g_fnkbmXlat[c]; if (t) { g_fnkbmXlatRead = YES; return t; } }
+    return c;
+}
+static NSString *fnkbmHookedCharacters(id self, SEL _cmd) {
+    NSInteger c = g_origUIKeyKeyCode ? g_origUIKeyKeyCode(self, @selector(keyCode)) : 0;
+    if (g_fnkbmReplayUp && c > 0 && c < 512 && g_fnkbmGameDown[c] && g_fnkbmDownChars[c]) return g_fnkbmDownChars[c];
+    NSString *orig = g_origUIKeyCharacters(self, _cmd);
+    if (c <= 0 || c >= 512 || !g_fnkbmXlat[c]) return orig;
+    long k = g_fnkbmXlat[c];
+    if (k >= 4 && k <= 29) return [NSString stringWithFormat:@"%c", (char)('a' + (k - 4))];
+    if (k >= 30 && k <= 38) return [NSString stringWithFormat:@"%c", (char)('1' + (k - 30))];
+    if (k == 39) return @"0";
+    if (k == 40) return @"\r";
+    if (k == 43) return @"\t";
+    if (k == 44) return @" ";
+    return @"";
+}
+static void fnkbmInstallKeyTranslation(void) {
+    Class keyClass = objc_getClass("UIKey");
+    Method mk = keyClass ? class_getInstanceMethod(keyClass, @selector(keyCode)) : NULL;
+    Method mc = keyClass ? class_getInstanceMethod(keyClass, @selector(characters)) : NULL;
+    if (!mk) { KLOG("key translation off: no UIKey keyCode"); return; }
+    g_fnkbmPressOrig = [NSMutableDictionary dictionary];
+    SEL sels[4] = { @selector(pressesBegan:withEvent:), @selector(pressesEnded:withEvent:),
+                    @selector(pressesCancelled:withEvent:), @selector(pressesChanged:withEvent:) };
+    unsigned int n = 0; int hooked = 0;
+    const char **names = objc_copyClassNamesForImage(_dyld_get_image_name(0), &n);
+    for (unsigned int i = 0; names && i < n; i++) {
+        Class c = objc_getClass(names[i]);
+        if (!c) continue;
+        unsigned int mcount = 0;
+        Method *ml = class_copyMethodList(c, &mcount);
+        for (unsigned int j = 0; ml && j < mcount; j++) {
+            for (int q = 0; q < 4; q++) {
+                if (!sel_isEqual(method_getName(ml[j]), sels[q])) continue;
+                g_fnkbmPressOrig[[NSString stringWithFormat:@"%p/%s", (void *)c, sel_getName(sels[q])]] =
+                    [NSValue valueWithPointer:(void *)method_getImplementation(ml[j])];
+                method_setImplementation(ml[j], (IMP)fnkbmHookedPresses);
+                hooked++;
+                KLOG("key translation: hooked %{public}s %{public}s", names[i], sel_getName(sels[q]));
+            }
+        }
+        free(ml);
+    }
+    free(names);
+    if (hooked == 0) { KLOG("key translation off: the game has no key press methods"); return; }
+    g_origUIKeyKeyCode = (NSInteger (*)(id, SEL))method_getImplementation(mk);
+    method_setImplementation(mk, (IMP)fnkbmHookedKeyCode);
+    if (mc) { g_origUIKeyCharacters = (NSString *(*)(id, SEL))method_getImplementation(mc); method_setImplementation(mc, (IMP)fnkbmHookedCharacters); }
+    g_fnkbmKeysInProcess = YES;
+    void *cg = dlopen("/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics", RTLD_NOW);
+    if (cg) _CGEventSourceKeyState = (bool (*)(int32_t, uint16_t))dlsym(cg, "CGEventSourceKeyState");
+    KLOG("key translation on (%d methods), keyboard state read=%d", hooked, _CGEventSourceKeyState != NULL);
+}
