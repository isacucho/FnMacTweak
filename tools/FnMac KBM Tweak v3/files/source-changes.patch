+// Game log lines about texture detail, optional texture downloads, memory and the input
+// type (touch, mouse, controller), copied to the tweak's log (at most 80): the game's own
+// log cannot be read from outside the app.
+static void fnkbmForwardGameLines(const char *p, size_t len) {
+    static int sent = 0;
+    static const char *keys[] = {"HighResMips", "Optional Bundles", "OptionalBundle", "InstallBundle", "ReducedTextures", "MaxCacheSize", "texture pool",
+                                 "TooMuchInUse", "DiskQuota", "UseAllMips", "MemoryBucket", "Memory bucket", "entitlement", "virtual memory",
+                                 "CommonInput", "InputMethod"};
+    const char *end = p + len;
+    while (p < end && sent < 80) {
+        const char *nl = (const char *)memchr(p, '\n', (size_t)(end - p));
+        size_t n = nl ? (size_t)(nl - p) : (size_t)(end - p);
+        // Repeated or bulky lines that would use up the cap.
+        static const char *skip[] = {"MinScreenPercentage", "CleanupOldBundles", "download type changed", "PerformActionOnce",
+                                     "Found up to date bundle", "Loaded Manifest", "Lang."};
+        BOOL noise = NO;
+        for (size_t k = 0; k < sizeof(skip) / sizeof(skip[0]) && !noise; k++) noise = memmem(p, n, skip[k], strlen(skip[k])) != NULL;
+        if (!noise)
+        for (size_t k = 0; k < sizeof(keys) / sizeof(keys[0]); k++)
+            if (memmem(p, n, keys[k], strlen(keys[k]))) { sent++; KLOG("game log: %{public}.*s", (int)MIN(n, (size_t)300), p); break; }
+        p += n + 1;
+    }
+}
