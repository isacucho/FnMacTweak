+static void fnkbmShowGraphicsPanel(void) {
+    if (g_fnkbmGfxPanelOpen) return;
+    UIWindow *game = fnkbmGameUIWindow();
+    if (!game.windowScene) { KLOG("graphics panel: no game window to show it on"); return; }
+    // A bind the popup was waiting for is cancelled, so the panel gets its keys and clicks.
+    if (keyCaptureCallback || mouseButtonCaptureCallback) KLOG("graphics panel: bind capture of the popup cancelled");
