+             [d[@"id"] unsignedIntValue], d[@"key"], d[@"name"], [d[@"builtin"] boolValue], [d[@"ptsW"] doubleValue], [d[@"ptsH"] doubleValue],
+             d[@"nativeW"], d[@"nativeH"], d[@"source"], [d[@"hz"] doubleValue]);
+}
